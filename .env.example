# dotty environment configuration
#
# Copy this file to .env (not committed) and adjust as needed.

# Custom dotfiles repository path (default: ~/.dotty)
# DOTTY_HOME=/path/to/your/dotfiles

# Custom state directory (default: platform-specific, e.g. ~/.local/share/dotty)
# DOTTY_STATE_HOME=/path/to/state

# Force build.rs to re-run (set to any non-empty value).
# Useful after switching branches when cargo does not detect the change.
# DOTTY_FORCE_BUILD=1
